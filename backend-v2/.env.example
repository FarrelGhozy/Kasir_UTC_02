# Template env untuk backend-v2 — JANGAN simpan secret asli di sini
DATABASE_URL="postgresql://utc:***@localhost:27019/utc_v2?schema=public"
PORT=5300
JWT_SECRET=""            # wajib >= 32 char (openssl rand -hex 32)
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:8090"
NODE_ENV="development"
SEED_ADMIN_PASSWORD=""   # wajib >= 12 char, hanya untuk seed pertama
