# Kasir UTC — root .env (docker-compose.yml V1 + v2).
# Salin file ini jadi `.env` lalu isi nilai asli. JANGAN commit .env (sudah di .gitignore).
# #startup-audit S1: semua secret WAJIB di sini — docker-compose.yml tidak boleh
# berisi nilai literal (nilai lama `adminutc28` sudah bocor di git history —
# sebaiknya ROTASI / ganti dengan nilai baru).

# ── V1 (docker-compose.yml — backend Node + WAHA) ────────────────────────────
JWT_SECRET=                # minimal 32 karakter acak — generate: openssl rand -base64 48
WAHA_API_KEY=              # API key WAHA (backend & waha harus sama)
WAHA_SWAGGER_USERNAME=admin-utc01
WAHA_SWAGGER_PASSWORD=     # password Swagger WAHA
WAHA_DASHBOARD_USERNAME=admin-utc01
WAHA_DASHBOARD_PASSWORD=   # password Dashboard WAHA

# ── V2 (docker-compose.v2.yml — Postgres + backend Bun) ──────────────────────
POSTGRES_PASSWORD=         # password role postgres v2
