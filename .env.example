# ==============================================================================
# Bengkel UTC — Template Environment Terpusat (SINGLE SOURCE OF TRUTH)
# ==============================================================================
# CARA PAKAI:
#   1. Salin file ini menjadi `.env` di folder ROOT project (sejajar docker-compose.yml):
#        cp .env.example .env
#   2. Isi semua variabel bertanda [WAJIB].
#   3. Jangan pernah commit file `.env` ke Git (sudah diabaikan via .gitignore).
#
# KONTEKS NILAI:
#   - Nilai aktif di bawah ini adalah untuk Docker Compose (antar-container
#     saling memanggil via hostname service: mongo_db, backend, waha).
#   - Untuk menjalankan backend LANGSUNG di laptop (npm run dev), ganti:
#       MONGODB_URI=mongodb://localhost:27018/bengkel_utc
#       WAHA_URL=http://localhost:8000
# ==============================================================================

# ------------------------------------------
# Server Backend
# ------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------
# Database MongoDB [WAJIB]
# ------------------------------------------
# MongoDB berjalan DENGAN autentikasi. Buat kredensial root yang kuat:
#   Generate password:  openssl rand -base64 24
MONGO_ROOT_USER=utc_admin
MONGO_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=bengkel_utc
# URI wajib memakai kredensial di atas (authSource=admin karena user root):
# Docker (aktif default — hostname "mongo_db" hanya dikenal di dalam network Docker):
MONGODB_URI=mongodb://utc_admin:GANTI_PASSWORD_DISINI@mongo_db:27017/bengkel_utc?authSource=admin
# Lokal tanpa Docker (aktifkan baris ini jika backend dijalankan via "npm run dev"):
# MONGODB_URI=mongodb://utc_admin:GANTI_PASSWORD_DISINI@localhost:27018/bengkel_utc?authSource=admin
#
# MIGRASI dari instalasi lama (tanpa auth): user root hanya dibuat otomatis saat
# volume masih kosong. Untuk volume berisi data lama, buat user manual sekali saja:
#   docker compose exec mongo_db mongosh -u <user> -p --eval 'db.getSiblingDB("admin").createUser({user:"utc_admin",pwd:"...",roles:[{role:"root",db:"admin"}]})'
# Lalu update MONGODB_URI di atas dan restart.

# ------------------------------------------
# Autentikasi JWT [WAJIB]
# ------------------------------------------
# Kunci rahasia penanda-tangan token login. MINIMAL 32 karakter acak.
# Generate dengan:  openssl rand -hex 32
# Backend akan MENOLAK start jika kosong, terlalu pendek, atau masih nilai default.
JWT_SECRET=

# ------------------------------------------
# WhatsApp Gateway (WAHA) [WAJIB di Docker]
# ------------------------------------------
# Docker (aktif default):
WAHA_URL=http://waha:8000
# Lokal tanpa Docker (aktifkan baris ini jika backend dijalankan via "npm run dev"):
# WAHA_URL=http://localhost:8000
WAHA_SESSION=default
# API Key WAHA — WAJIB diisi, tanpa nilai default demi keamanan.
WAHA_API_KEY=
# Secret opsional untuk mengamankan endpoint POST /api/waha-webhook.
# Jika diisi, set juga di dashboard WAHA > Webhook > query parameter: token=<isi-secret>
# Jika dikosongkan, webhook menerima semua request (kompatibel mundur).
WAHA_WEBHOOK_SECRET=
# URL internal backend (dipakai untuk membangun link file nota di pesan WA).
BACKEND_URL=http://backend:5000

# ------------------------------------------
# Kredensial Dashboard & Swagger WAHA [WAJIB]
# ------------------------------------------
WHATSAPP_SWAGGER_USERNAME=admin-utc01
WHATSAPP_SWAGGER_PASSWORD=
WAHA_DASHBOARD_USERNAME=admin-utc01
WAHA_DASHBOARD_PASSWORD=

# ------------------------------------------
# Email Nota Digital / SMTP Gmail (opsional)
# ------------------------------------------
# Diperlukan agar nota otomatis terkirim saat tiket servis berstatus "Completed".
# EMAIL_PASS adalah App Password 16 digit Google (bukan password Gmail biasa).
# Cara membuat: Akun Google > Keamanan > Verifikasi 2 Langkah > Sandi Aplikasi.
# Jika dikosongkan, fitur email nonaktif dan backend hanya mencatat warning.
EMAIL_USER=
EMAIL_PASS=

# ------------------------------------------
# Fitur Tambahan
# ------------------------------------------
# Daftar origin frontend yang diizinkan, pisahkan dengan koma untuk production.
# Contoh production: CORS_ORIGIN=https://kasir.utc.web.id,https://www.kasir.utc.web.id
CORS_ORIGIN=*
# Mode acara kampus: "true" membuat bot WA menjawab sedang tutup acara wajib kampus.
IS_CAMPUS_EVENT=false

# ------------------------------------------
# QR Code Verifikasi Nota
# ------------------------------------------
# URL publik halaman verifikasi yang di-encode ke QR Code pada nota PDF.
# Harus mengarah ke frontend yang bisa diakses customer dari HP.
NOTA_VERIFY_URL=https://kasir.utc.web.id/verify.html

# ------------------------------------------
# Port Host (opsional — mapping port laptop -> container)
# ------------------------------------------
HOST_BACKEND_PORT=5200
HOST_FRONTEND_PORT=8080
HOST_MONGO_PORT=27018
HOST_WAHA_PORT=8000
# IP Tailscale host ini (cek dengan: tailscale ip -4). Dipakai docker-compose.yml
# untuk bind WAHA agar bisa diakses dari tailnet tanpa expose ke internet publik.
# Jika kosong, fallback ke 100.78.190.70 (lihat docker-compose.yml).
TAILSCALE_IP=100.78.190.70
